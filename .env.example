dotenv
# Required PostgreSQL control-plane connection.
DATABASE_URL=postgres://santini:santini@postgres:5432/santini_gateway

# Required administrator bearer token.
SANTINI_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional client bearer token for /graphql.
# Leave empty only when downstream services independently authenticate every caller.
SANTINI_CLIENT_TOKEN=replace-with-a-separate-client-secret

# Bun HTTP listener.
PORT=8080
HOST=0.0.0.0

# Restrict subgraph registration to approved endpoint hosts in production.
# Comma-separated hostnames; leave blank only for local development.
SANTINI_ALLOWED_SUBGRAPH_HOSTS=accounts-subgraph,products-subgraph

# Gateway request boundaries.
SANTINI_SUBGRAPH_TIMEOUT_MS=20000
SANTINI_HEALTH_TIMEOUT_MS=3000

# Optional OpenTelemetry endpoint, such as http://otel-collector:4318/v1/traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=santini-gateway

